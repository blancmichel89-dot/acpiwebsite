rules_version = '2';

// Toutes les lectures/écritures passent par les routes API (app/api/...), qui
// utilisent le SDK Admin (accès serveur, non soumis à ces règles).
// Ces règles bloquent donc tout accès direct depuis un navigateur, ce qui est
// le comportement voulu : le client Nicobat n'appelle jamais Firestore
// directement, uniquement via l'app Next.js hébergée sur Cloud Run.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
