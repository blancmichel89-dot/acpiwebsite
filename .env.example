# === Firebase / Firestore (gratuit, plan Spark, pas de carte bancaire) ===
# Console Firebase > Paramètres du projet > Comptes de service >
# "Générer une nouvelle clé privée" télécharge un fichier JSON.
# Encoder ce fichier en base64 avant de le coller ici (une seule ligne,
# évite les problèmes de sauts de ligne dans la clé privée) :
#   macOS/Linux : base64 -i service-account.json | tr -d '\n'
#   Windows PowerShell : [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_KEY=

# === Gmail API (envoi des devis/factures depuis l'adresse de Nicolas) ===
# Créés dans le MÊME projet Google Cloud que Firebase (lié automatiquement),
# section APIs & Services > Identifiants. Ne demande pas de carte bancaire.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://VOTRE-SITE.netlify.app/api/auth/callback
# Généré une seule fois après que Nicolas ait autorisé l'application (écran de consentement OAuth)
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=contact@nicobat.fr

# === Application ===
NEXT_PUBLIC_APP_NAME=Nicobat
NEXT_PUBLIC_APP_URL=https://VOTRE-SITE.netlify.app
